{
  "name": "dsh-preset-builder",
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "check": "eslint . && node --check client.js && node --check index.js && node --check lib/inventory.mjs && node --check lib/rules.mjs && node --check lib/diff.mjs && node --check lib/expressions.mjs && node --check ../test/ui-smoke.mjs",
    "test": "node ../test/unit.mjs"
  },
  "description": "Build custom Agent presets in the DSH Web UI: collect package rows, edit groups and config, save as ordinary preset declarations.",
  "author": "cningan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cningan/dsh-preset-builder.git"
  },
  "homepage": "https://github.com/cningan/dsh-preset-builder#readme",
  "bugs": {
    "url": "https://github.com/cningan/dsh-preset-builder/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "agent-preset",
    "plugin"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "yaml": "^2.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "eslint": "^10.14.0"
  }
}
